{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Fundable",
  "version": "0.1.0",
  "description": "See who a company is and what they raised — from their website, LinkedIn, or Crunchbase.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://fundable-extension-api.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fundable"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
