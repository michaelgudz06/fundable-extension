{
  "manifest_version": 3,
  "minimum_chrome_version": "103",
  "name": "Fundable",
  "version": "0.1.0",
  "description": "See who a company is and what they raised — from their website, LinkedIn, or Crunchbase.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://fundable-extension-api.vercel.app; img-src 'self' data:; font-src https://www.tryfundable.ai; style-src 'self'"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://fundable-extension-api.vercel.app/*"
  ],
  "action": {
    "default_title": "Fundable"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
