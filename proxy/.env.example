# Copy to .env.local (gitignored) for local dev. Never commit real values.

# Required
FUNDABLE_API_KEY=
FUNDABLE_BASE_URL=https://www.tryfundable.ai/api/v1

# Required in production: the extension's pinned origin, e.g. chrome-extension://abcdef...
# Unset means every browser request carrying an Origin header is refused.
ALLOWED_EXTENSION_ORIGIN=

# Optional. Without both, the cache falls back to an in-process Map (see lib/cache.ts) and
# DAILY_CREDIT_LIMIT below is counted per instance, so real spend scales with warm instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional guards
RATE_LIMIT_PER_MIN=30
DAILY_CREDIT_LIMIT=500
KILL_SWITCH=
